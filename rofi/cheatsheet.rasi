window {
    location: center;
    width: 60%;
    height: 85%;
    background-color: rgba(20, 20, 20, 0.92);
    border: 1px;
    border-color: #7AA2F7;
    border-radius: 12px;
    padding: 16px;
}

mainbox {
    orientation: vertical;
    background-color: transparent;
    spacing: 8px;
}

inputbar {
    enabled: false;
    background-color: transparent;
}

listview {
    background-color: transparent;
    border: 0;
    spacing: 4px;
    padding: 4px;
    scrollbar: false;
    lines: 40;
    columns: 1;
    fixed-height: false;
}

element {
    background-color: transparent;
    border: 0;
    border-radius: 8px;
    padding: 8px 14px;
    spacing: 8px;
}

element-text {
    background-color: transparent;
    text-color: #E6EAF2FF;
    font: "Iosevka Nerd Font 13";
    vertical-align: 0.5;
}

element selected {
    background-color: #7AA2F7;
}

element selected element-text {
    text-color: #111318FF;
}

element normal.normal,
element alternate.normal {
    background-color: transparent;
}

element selected.normal,
element selected.active {
    background-color: #7AA2F733;
}

element selected.normal element-text,
element selected.active element-text {
    text-color: #E6EAF2FF;
}

scrollbar {
    width: 4px;
    background-color: transparent;
    handle-color: #7AA2F733;
    handle-width: 4px;
}